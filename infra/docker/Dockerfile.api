# syntax=docker/dockerfile:1.7

# Westside API — single-stage Dockerfile
# Runs TypeScript directly via tsx (no separate build step needed).
# This avoids the pnpm-lock.yaml requirement and the multi-stage symlink issues.

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable
RUN apk add --no-cache python3 make g++

# Create non-root user
RUN addgroup -g 10001 -S westside && adduser -u 10001 -S -G westside westside

WORKDIR /westside

# Copy everything (lockfile + package.json files for proper pnpm install)
COPY --chown=westside:westside pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY --chown=westside:westside packages ./packages
COPY --chown=westside:westside database ./database
COPY --chown=westside:westside apps/api ./apps/api

# Install dependencies — use --no-frozen-lockfile so it works without a lockfile
RUN pnpm install --no-frozen-lockfile

# Install tsx globally so it's available on PATH
RUN npm install -g tsx

USER westside
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1:4000/health || exit 1
CMD ["tsx", "apps/api/src/server.ts"]
