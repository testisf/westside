{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Westside",
  "version": "0.4.0",
  "identifier": "com.westside.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Westside",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Dark",
        "backgroundColor": "#020617"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://*.roblox.com https://*.rbxcdn.com; connect-src 'self' https://api.westside.local http://localhost:4000 https://api.westside.example wss://api.westside.example ws://localhost:4000; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "devCsp": "default-src 'self'; img-src 'self' data: https:; connect-src 'self' http://localhost:4000 http://localhost:1420 ws://localhost:4000 ws://localhost:1420; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false,
      "tooltip": "Westside"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "© Westside",
    "category": "Utility",
    "shortDescription": "Westside desktop client",
    "longDescription": "Westside is a production-grade communications platform for ERLC communities on Roblox.",
    "publisher": "Westside",
    "homepage": "https://westside.example",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libssl3", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.westside.example/desktop/manifest.json"
      ],
      "pubkey": "REPLACE_WITH_BASE64_PUBLIC_KEY_AT_BUILD_TIME",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
