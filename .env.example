# ============================================================================
# Westside environment configuration
# Copy to .env and edit. NEVER commit .env.
# ============================================================================

# ---------- App ----------
NODE_ENV=development
LOG_LEVEL=debug

# ---------- API ----------
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,https://localhost:3000

# ---------- Web ----------
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000

# ---------- Database ----------
# Format: postgresql://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgresql://westside:westside_dev_pw@localhost:5432/westside
# Read-only replica (optional; falls back to DATABASE_URL if unset)
DATABASE_REPLICA_URL=

# ---------- Redis ----------
REDIS_URL=redis://:westside_dev_redis@localhost:6379/0

# ---------- JWT signing keys ----------
# Generate with:
#   openssl genpkey -algorithm RSA -out .keys/jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in .keys/jwt-private.pem -pubout -out .keys/jwt-public.pem
JWT_PRIVATE_KEY_PATH=.keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.keys/jwt-public.pem
JWT_ISSUER=westside
JWT_AUDIENCE=westside-clients
# Seconds. Access tokens are intentionally short-lived.
ACCESS_TOKEN_TTL=60
# Seconds. Refresh tokens last 30 days.
REFRESH_TOKEN_TTL=2592000

# ---------- Argon2id parameters ----------
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ---------- Rate limiting ----------
RATE_LIMIT_PER_MINUTE_IP=120
RATE_LIMIT_PER_MINUTE_USER=600
LOGIN_RATE_LIMIT_PER_15MIN=5

# ---------- Account lockout ----------
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# ---------- Email verification / password reset (Phase 2 will wire SMTP) ----------
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=15
MAIL_FROM=Westside <no-reply@westside.local>

# ---------- Bootstrap (used by `pnpm db:seed`) ----------
BOOTSTRAP_OWNER_EMAIL=owner@westside.local
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=ChangeMe!Strong-Password-2026
